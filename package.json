{
  "name": "wanqara-e2e",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --project=Smoke --workers=2",
    "test:release": "playwright test --grep @release",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"e2e/**/*.ts\" playwright.config.ts",
    "lint:fix": "eslint \"e2e/**/*.ts\" playwright.config.ts --fix",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/mcp": "^0.0.80",
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.6.1",
    "eslint": "^9.0.0",
    "eslint-plugin-playwright": "^2.12.0",
    "globals": "^15.0.0",
    "knip": "^6.36.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}